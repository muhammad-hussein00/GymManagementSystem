@using GymManagementDAL.Models.Enums
@model TrainerToUpdateViewModel

<div class="container mt-4">
    <header class="mb-4">
        <h3 class="text-primary-color">Edit Trainer</h3>
        <p class="text-muted">Update trainer information</p>
    </header>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <div class="mb-4 pb-3 border-bottom">
                        <small class="text-muted d-block mb-1">Editing Profile For</small>
                        <h4 class="mb-0 text-black">@Model.Name</h4>
                    </div>
                    <form asp-action="Edit" method="post">
                        <!-- Personal Information -->
                        <input hidden readonly asp-for="Name" />
                        <div class="section-header mb-3">
                            <h5 class="text-primary fw-bold">Personal Information</h5>
                            <hr class="mt-2">
                        </div>
                        <div class="row g-3 mb-4">

                            <div class="col-md-6">
                                <label asp-for ="@Model.Email" class="form-label">Email Address</label>
                                <input asp-for="@Model.Email" type="text" class="form-control" />
                                <span asp-validation-for="Email"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="@Model.Phone" class="form-label">Phone</label>
                                <input asp-for="@Model.Phone" type="text" class="form-control" />
                                <span asp-validation-for="Phone"></span>

                            </div>
                            <div class="col-md-6">
                                <label asp-for="@Model.BuildingNumber" class="form-label">BuildingNumber</label>
                                <input asp-for="@Model.BuildingNumber" type="text" class="form-control" />
                                <span asp-validation-for="BuildingNumber"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="@Model.Street" class="form-label">Street</label>
                                <input asp-for="@Model.Street" type="text" class="form-control" />
                                <span asp-validation-for="Street"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="@Model.City" class="form-label">City</label>
                                <input asp-for="@Model.City" type="text" class="form-control" />
                                <span asp-validation-for="City"></span>
                            </div>
                        </div>

                        <!-- Professional Information -->
                        <div class="section-header mb-3">
                            <h5 class="text-primary fw-bold">Professional Information</h5>
                            <hr class="mt-2">
                        </div>
                        <div class="row g-3">

                            <div class="col-12">
                                <label class="form-label fw-semibold">
                                    Specializations <span class="text-danger">*</span>
                                </label>

                                @foreach (var speciality in Html.GetEnumSelectList<Specialty>())
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" asp-for="Specialization"
                                               value="@speciality.Value"
                                               id="@speciality.Value" />
                                        <label class="form-check-label" asp-for="@speciality.Value">@speciality.Text</label>
                                    </div>
                                }

                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline">
                                <i class="bi bi-arrow-left me-1"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-fill">
                                <i class="bi bi-check-lg me-1"></i>Update Trainer
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}
